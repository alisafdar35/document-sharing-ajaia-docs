{
  "name": "@ajaia-docs/server",
  "version": "1.0.0",
  "private": true,
  "description": "Ajaia Docs API server",
  "main": "dist/index.js",
  "scripts": {
    "prepare:db": "node scripts/prepare-prisma.mjs",
    "setup": "node scripts/prepare-prisma.mjs && prisma generate && prisma db push && npm run db:seed",
    "dev": "node scripts/prepare-prisma.mjs && tsx watch src/index.ts",
    "build": "node scripts/prepare-prisma.mjs && prisma generate && tsc",
    "start": "node dist/index.js",
    "deploy:db": "node scripts/prepare-prisma.mjs && prisma db push --skip-generate && tsx prisma/seed.ts",
    "start:prod": "npm run deploy:db && node dist/index.js",
    "test": "node scripts/prepare-prisma.mjs --provider sqlite && prisma generate && vitest run",
    "test:watch": "vitest",
    "db:push": "node scripts/prepare-prisma.mjs && prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
