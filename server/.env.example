# ---------------------------------------------------------------------------
# Ajaia Docs - server environment
# Copy to .env (npm run setup does this automatically) and adjust as needed.
# ---------------------------------------------------------------------------

# Local development (SQLite). The path is relative to the prisma/ directory.
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL / Supabase). Swap the line above for something like:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require&pgbouncer=true"
# The Prisma datasource provider is derived from this URL automatically.

# Port the Express API listens on
PORT=4000

# Origin(s) allowed by CORS. Comma-separated list for multiple origins.
CLIENT_URL="http://localhost:5173"
